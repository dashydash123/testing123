# Rename this file to .env in the same folder as ado_users_to_flexera.py
# ── Azure SQL: DevSecOps shared DB (ABI prod) ─ read-only account ──
# Same values as github.env
SQL_SERVER=PASTE_FROM_GITHUB_ENV
SQL_DATABASE=PASTE_FROM_GITHUB_ENV
SQL_USERNAME=PASTE_FROM_GITHUB_ENV
# Keep the single quotes (password has & ^ @)
SQL_PASSWORD='PASTE_FROM_GITHUB_ENV'
SQL_PORT=1433

# Leave blank to auto-detect ODBC Driver 18/17
SQL_DRIVER=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERT=no
SQL_TIMEOUT=30

# ── What to extract ──
SQL_SCHEMA=dbo
SQL_TABLE=tblADO_user_master_table

# ── Output ──
OUTPUT_DIR=output
# Same file is overwritten on every run
OUTPUT_FILE=tblADO_user_master_table.csv

# ── Transform ──
# License = license_type + separator + org   (e.g. "Basic - ab-inbev")
LICENSE_SEPARATOR=" - "

# Licence types (license_type column) to leave out completely - comma-separated,
# not case-sensitive. Leave blank to keep everything.
# e.g. EXCLUDE_LICENSES=Stakeholder,Visual Studio Subscriber
EXCLUDE_LICENSES=

# ═════════════ Flexera (Snow Atlas) SaaS import – UAT ═════════════
# Same as github.env
FLEXERA_CLIENT_ID=PASTE_FROM_GITHUB_ENV
FLEXERA_CLIENT_SECRET=PASTE_FROM_GITHUB_ENV

# APIs – same as github.env
FLEXERA_TOKEN_URL=PASTE_FROM_GITHUB_ENV
FLEXERA_UPLOAD_URL=PASTE_FROM_GITHUB_ENV
FLEXERA_IMPORT_URL=PASTE_FROM_GITHUB_ENV

# Azure DevOps import configs (NOT the GitHub ones)
#   User assignment: email -> Email address | user_id -> Unique user identifier | License -> Subscription name
FLEXERA_ASSIGNMENTS_CONFIG_ID=PASTE_ADO_ASSIGNMENTS_CONFIG_ID
#   User activities: user_id -> Unique user identifier | last_accessed -> Activity name + recorded value
FLEXERA_ACTIVITIES_CONFIG_ID=PASTE_ADO_ACTIVITIES_CONFIG_ID

# yes = push to Flexera after the extract; no = build the files only
FLEXERA_PUSH=no
