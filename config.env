# Flexera / Snow Atlas API credentials and script settings.
# Keep this file private - do not email it or commit it to source control.

CLIENT_ID=PASTE_CLIENT_ID_HERE
CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE
REGION=westeurope

# Filters - "contains", case-insensitive, comma-separated for multiple values.
# Leave a line empty (e.g. VENDOR_CONTAINS=) to skip that filter.
VENDOR_CONTAINS=Microsoft
VENDOR_EXCLUDES=
APPLICATION_CONTAINS=
SUBSCRIPTION_CONTAINS=

# Discovery type of the subscription, comma-separated. Empty = all types.
#   0 SaaS connector | 1 Manually added | 2 Browser unverified | 3 SSO
#   4 Device         | 7 Browser verified | 8 CASB
DISCOVERY_TYPES=

# Tuning
SEED_USERS_PER_APP=200
MAX_WORKERS=8
