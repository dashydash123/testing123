# ── Azure SQL: DevSecOps shared DB (ABI prod) ─ read-only account ──
SQL_SERVER=ghq-06306-shared-cus-prod-sql.database.windows.net
SQL_DATABASE=ghq-08463-shared-db-Devsecops-cus-prod-sqldb
SQL_USERNAME=TmAppReader
# Paste the password between the single quotes (keep the quotes: it has & ^ @)
SQL_PASSWORD='PASTE_FROM_TEAMS_MESSAGE'
SQL_PORT=1433

# Leave blank to auto-detect ODBC Driver 18/17
SQL_DRIVER=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERT=no
SQL_TIMEOUT=30

# ── What to extract ──
SQL_SCHEMA=dbo
SQL_TABLE=tblGH_users

# ── Output ──
OUTPUT_DIR=output

# ── Transform ──
# License = role + separator + org  (e.g. "admin - ab-inbev")
LICENSE_SEPARATOR=' - '
