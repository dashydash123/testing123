# ── Azure SQL: DevSecOps shared DB (ABI prod) ─ read-only account ──
SQL_SERVER=ghq-06306-shared-cus-prod-sql.database.windows.net
SQL_DATABASE=ghq-08463-shared-db-Devsecops-cus-prod-sqldb
SQL_USERNAME=TmAppReader
SQL_PASSWORD='PASTE'
SQL_PORT=1433

# Leave blank to auto-detect ODBC Driver 18/17
SQL_DRIVER=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERT=no
SQL_TIMEOUT=30

# ── What to extract ──
SQL_SCHEMA=dbo
SQL_TABLE=tblGH_users

# ── Output ──
OUTPUT_DIR=output
# Same file is overwritten on every run
OUTPUT_FILE=tblGH_users.csv

# ── Transform ──
# License = role + separator + org  (e.g. "admin - ab-inbev")
LICENSE_SEPARATOR=' - '
# user_id = stable UUID built from these column(s); same input -> same id every run
# username,org = one id per org membership, so every org licence counts in Flexera
ID_FIELDS=username,org

# ═════════════ Flexera (Snow Atlas) SaaS import – UAT, same tenant as Zendesk ═════════════
# Copy these two from your Zendesk .env
FLEXERA_CLIENT_ID=PASTE_FROM_ZENDESK_ENV
FLEXERA_CLIENT_SECRET=PASTE_FROM_ZENDESK_ENV

# APIs
FLEXERA_TOKEN_URL=https://snowatlas-westeurope.flexera.eu/idp/api/connect/token
FLEXERA_UPLOAD_URL=https://snowatlas-westeurope.flexera.eu/api/saas/import/v1/uploads
FLEXERA_IMPORT_URL=https://snowatlas-westeurope.flexera.eu/api/saas/import/v1/configs/{config_id}/records/import

# GitHub Enterprise import configs
#   User assignment: email -> Email address | user_id -> Unique user identifier | License -> Subscription name
FLEXERA_ASSIGNMENTS_CONFIG_ID=8529d0ab-81c6-4d9a-9361-e77449767fe8
#   User activities: user_id -> Unique user identifier | last_accessed -> Activity name + recorded value
FLEXERA_ACTIVITIES_CONFIG_ID=be313010-46b8-4fd8-9e28-c575a11f2797

# yes = gh_users_extract.py pushes to Flexera automatically after a successful extract
FLEXERA_PUSH=yes
